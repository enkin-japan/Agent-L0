{
  "permissions": {
    "allow": [
      "Bash(./devctl.sh check *)",
      "Bash(./devctl.sh check)",
      "Bash(./devctl.sh preflight)",
      "Bash(./devctl.sh status)",
      "Bash(./devctl.sh logs *)"
    ]
  },
  "bashOutputMaxChars": 12000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-no-verify.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
