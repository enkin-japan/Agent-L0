+// Simdgroup count of the qmv_mma threadgroup. The [[kernel]] wrapper's
+// threadgroup scratch and the host-side group_dims (quantized.cpp qmv_mma)
+// must agree with this.
+MLX_MTL_CONST int QMV_MMA_SIMDGROUPS = 4;
+
+// simdgroup-matrix variant of qmv_wide for the dispatched range (M = 6..12):
+// the
+// scalar FMA inner loop there costs ALU proportional to vecs_per_tg x packing
+// (4-bit worst), while the weight bytes stay constant. Here each simdgroup
+// owns an 8-output-row x M tile and walks K in 8-value chunks as 8x8x8 MMAs.
+// Fragments are built per lane in registers via the steel BaseMMAFrag
+// coordinate map -- no threadgroup staging. All fragments are float, the same
+// numeric class as qmv_wide's float accumulate (and steel's AccumType).
+// Rows and vectors past the edge are clamped like qmv_wide (computed on
+// duplicate data, never stored).
+template <typename T, int group_size, int bits>
+METAL_FUNC void qmv_mma_impl(
+    const device uint32_t* w,
+    const device T* scales,
+    const device T* biases,
+    const device T* x,
+    device T* y,
+    threadgroup float* tg_acc, // scratch, [num_simdgroups - 1][32][2]
+    const constant int& in_vec_size,
+    const constant int& out_vec_size,
+    const constant int& M,
+    uint3 tid [[threadgroup_position_in_grid]],
+    uint simd_gid [[simdgroup_index_in_threadgroup]],
+    uint simd_lid [[thread_index_in_simdgroup]]) {
+  constexpr int num_simdgroups = QMV_MMA_SIMDGROUPS;
+  constexpr int rows_per_tg = 8;
+  constexpr int chunks = group_size / 8;
+  static_assert(group_size % 8 == 0, "qmv_mma needs group_size % 8 == 0");
+
+  typedef float U;
+
+  // steel BaseMMAFrag<T, 8, 8> coordinate map: each lane owns fragment
+  // elements (fm, fn) and (fm, fn + 1).
+  const short qid = simd_lid / 4;
+  const short fm = (qid & 4) + ((simd_lid / 2) % 4);
+  const short fn = (qid & 2) * 2 + (simd_lid % 2) * 2;
+
+  // All simdgroups share one 8-row x 8-vector tile and split K: the kernel is
+  // issue bound, so the serial per-lane chunk walk is what has to shrink.
+  const int n0 = tid.y * rows_per_tg;
+  const int vec0 = tid.x * 8;
+
+  const int in_vec_size_w = in_vec_size * bits / 8; // bytes per weight row
+  const int in_vec_size_g = in_vec_size / group_size;
+  // Uneven splits handled: idle simdgroups contribute zero fragments.
+  const int g_lo = (in_vec_size_g * (int)simd_gid) / num_simdgroups;
+  const int g_hi = (in_vec_size_g * ((int)simd_gid + 1)) / num_simdgroups;
+
+  // B fragment sources: element (fm, fn + j) = dq(w[n0 + fn + j][k0 + fm]).
+  const int row_a = min(n0 + fn, out_vec_size - 1);
+  const int row_b = min(n0 + fn + 1, out_vec_size - 1);
+  const device uint8_t* wr_a = (const device uint8_t*)w + row_a * in_vec_size_w;
+  const device uint8_t* wr_b = (const device uint8_t*)w + row_b * in_vec_size_w;
+  const device T* sr_a = scales + row_a * in_vec_size_g;
+  const device T* sr_b = scales + row_b * in_vec_size_g;
+  const device T* br_a = biases + row_a * in_vec_size_g;
+  const device T* br_b = biases + row_b * in_vec_size_g;
+
+  // A fragment source: element (fm, fn + j) = x[vec0 + fm][k0 + fn + j].
+  const device T* xr = x + min(vec0 + fm, M - 1) * in_vec_size;
+
+  // A/B fragments carry T (A is exact: x already is T; B rounds the decoded
+  // weight to T once, the same envelope as the qmm path's threadgroup
+  // staging); the accumulator is float, like qmv_wide's and steel's.
+  // Measured on M4 Max (31B shapes): fragment dtype, accumulator dtype, dual
+  // accumulators and the simdgroup layout move the wall time by at most a few
+  // percent -- the kernel is pinned by total ALU issue, simdgroup_matrix
+  // having no dedicated hardware on this generation. A per-group T-accumulate
+  // variant was 1-3% faster but blew the f16 error budget (ratios up to 6x vs
+  // qmv_wide at gs128); this form is error-neutral-or-better everywhere.
+  auto C = make_filled_simdgroup_matrix<U, 8, 8>(U(0));
+
+  for (int g = g_lo; g < g_hi; g++) {
+    const U s_a = sr_a[g];
+    const U b_a = br_a[g];
+    const U s_b = sr_b[g];
+    const U b_b = br_b[g];
+#pragma unroll
+    for (int c = 0; c < chunks; c++) {
+      const int k0 = g * group_size + c * 8;
+      simdgroup_matrix<T, 8, 8> A;
+      simdgroup_matrix<T, 8, 8> B;
+      // Scalar loads on purpose: x may be a zero-copy view whose element
+      // offset (or batch stride) breaks vec<T,2> alignment. The compiler
+      // merges these when the pointer is provably aligned (review finding;
+      // same reason steel's BaseMMAFrag::load is scalar).
+      A.thread_elements()[0] = xr[k0 + fn];
+      A.thread_elements()[1] = xr[k0 + fn + 1];
+      const int kk = k0 + fm;
+      B.thread_elements()[0] =
+          static_cast<T>(s_a * extract_q<bits>(wr_a, kk) + b_a);
+      B.thread_elements()[1] =
+          static_cast<T>(s_b * extract_q<bits>(wr_b, kk) + b_b);
+      simdgroup_multiply_accumulate(C, A, B, C);
+    }
+  }
+
+  // Cross-simdgroup K reduction through threadgroup memory. (No barrier
+  // before the writes: this is the first threadgroup-memory access.)
+  if (simd_gid > 0) {
+    tg_acc[((int)simd_gid - 1) * 64 + (int)simd_lid * 2] =
+        C.thread_elements()[0];
+    tg_acc[((int)simd_gid - 1) * 64 + (int)simd_lid * 2 + 1] =
+        C.thread_elements()[1];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (simd_gid == 0) {
+    U r0 = C.thread_elements()[0];
+    U r1 = C.thread_elements()[1];
+#pragma unroll
+    for (int s = 0; s < num_simdgroups - 1; s++) {
+      r0 += tg_acc[s * 64 + (int)simd_lid * 2];
+      r1 += tg_acc[s * 64 + (int)simd_lid * 2 + 1];
+    }
+    const int vrow = vec0 + fm;
+    if (vrow < M) {
+      if (n0 + fn < out_vec_size) {
+        y[vrow * out_vec_size + n0 + fn] = static_cast<T>(r0);
+      }
+      if (n0 + fn + 1 < out_vec_size) {
+        y[vrow * out_vec_size + n0 + fn + 1] = static_cast<T>(r1);
+      }
+    }
+  }
+}
