+// One dequantized element (scale * q + bias done by the caller) at position k
+// of a packed row. Byte-aligned power-of-2 widths only: the per-element decode
+// is what lets each lane fill exactly its two B-fragment slots.
+template <int bits>
+METAL_FUNC float extract_q(const device uint8_t* wrow, int k) {
+  static_assert(
+      bits == 2 || bits == 4 || bits == 8,
+      "qmv_mma supports only byte-aligned power-of-2 bit widths");
+  if (bits == 8) {
+    return float(wrow[k]);
+  } else if (bits == 4) {
+    return float((wrow[k >> 1] >> ((k & 1) * 4)) & 0x0f);
+  } else {
+    return float((wrow[k >> 2] >> ((k & 3) * 2)) & 0x03);
+  }
+}
