# tool_call 种子批次（自造，2026-07-30）：每题瞄准一个测量面——参数类型还原/多工具选择/
# 无工具克制/多行字符串保真/必填纪律。借题扩量在 E6（BFCL 改写，配 VETTING.md）。
{"id": "tc-seed-001", "dimension": "tool_call", "lang": "en", "source": {"origin": "self", "fit": "自家 API 工具最常见形态（城市查询类），测必填 string 参数还原 + 可选参数纪律 + 工具结果整合成终答"}, "task": {"user": "What's the weather in Tokyo?", "tools": [{"name": "get_weather", "description": "Query current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string"}, "days": {"type": "integer", "description": "forecast days, default 1"}}, "required": ["city"]}}], "tool_responses": {"get_weather": {"city": "Tokyo", "forecast": "sunny", "temp_c": 31}}}, "expect": {"type": "tool_call", "call": {"name": "get_weather", "args": {"city": {"eq": "Tokyo"}, "days": {"optional": true, "type": "integer"}}}, "final": {"must_any": ["31", "sunny", "晴"]}}}
{"id": "tc-seed-002", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "同形工具的中文任务面：中文实体作参数值（城市名保真不翻译漂移是路由中文任务的前提）"}, "task": {"user": "北京今天天气怎么样？", "tools": [{"name": "get_weather", "description": "Query current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string"}, "days": {"type": "integer"}}, "required": ["city"]}}], "tool_responses": {"get_weather": {"city": "北京", "forecast": "多云", "temp_c": 28}}}, "expect": {"type": "tool_call", "call": {"name": "get_weather", "args": {"city": {"in": ["北京", "Beijing", "beijing"]}}}, "final": {"must_any": ["28", "多云"]}}}
{"id": "tc-seed-003", "dimension": "tool_call", "lang": "en", "source": {"origin": "self", "fit": "整数参数类型还原的跨方言对照点：gemma4 走 JSON 原生 int，qwen35 走 XML 文本 _coerce——eq 15 是类型敏感断言"}, "task": {"user": "Set a timer for 15 minutes.", "tools": [{"name": "set_timer", "description": "Set a countdown timer.", "parameters": {"type": "object", "properties": {"minutes": {"type": "integer"}}, "required": ["minutes"]}}], "tool_responses": {"set_timer": {"status": "timer_set", "minutes": 15}}}, "expect": {"type": "tool_call", "call": {"name": "set_timer", "args": {"minutes": {"eq": 15, "type": "integer"}}}, "final": {"must_any": ["15"]}}}
{"id": "tc-seed-004", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "布尔参数还原（true/false 字面量经方言各自通路）+ 从口语「全天的那种」推断布尔值——日程提醒是本项目定时任务的真实使用面"}, "task": {"user": "帮我设个明天交房租的提醒，全天的那种。", "tools": [{"name": "create_reminder", "description": "Create a reminder.", "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "date": {"type": "string", "description": "YYYY-MM-DD"}, "all_day": {"type": "boolean"}}, "required": ["title"]}}], "tool_responses": {"create_reminder": {"status": "created", "id": "rem-1"}}}, "expect": {"type": "tool_call", "call": {"name": "create_reminder", "args": {"title": {"contains": "房租"}, "all_day": {"eq": true, "type": "boolean"}}}, "final": {"must_any": ["提醒", "reminder", "创建", "设好", "已设"]}}}
{"id": "tc-seed-005", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "数组参数还原（qwen35 XML 里数组值须 tojson 写回、_coerce 读回对称；gemma4 JSON 原生）——清单类操作是自家笔记/待办工具的真实形态"}, "task": {"user": "把牛奶、鸡蛋和面包加进购物清单。", "tools": [{"name": "add_shopping_items", "description": "Add items to the shopping list.", "parameters": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "string"}}}, "required": ["items"]}}], "tool_responses": {"add_shopping_items": {"status": "ok", "count": 3}}}, "expect": {"type": "tool_call", "call": {"name": "add_shopping_items", "args": {"items": {"type": "array", "contains_all": ["牛奶", "鸡蛋", "面包"]}}}, "final": {"must_any": ["购物", "清单", "加", "added"]}}}
{"id": "tc-seed-006", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "三工具并列下的选择正确率（计算题选 calculator 而非 search）——多工具目录是编排层常态，选错工具比格式错误更伤路由"}, "task": {"user": "89 乘 47 等于多少？", "tools": [{"name": "search_web", "description": "Search the web.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}, {"name": "get_weather", "description": "Query current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}, {"name": "calculator", "description": "Evaluate an arithmetic expression.", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}], "tool_responses": {"calculator": {"result": 4183}}}, "expect": {"type": "tool_call", "call": {"name": "calculator", "args": {"expression": {"regex": "89\\s*[*×x]\\s*47"}}}, "final": {"must_any": ["4183"]}}}
{"id": "tc-seed-007", "dimension": "tool_call", "lang": "en", "source": {"origin": "self", "fit": "时效性任务选 search_web（与 tc-seed-006 同目录反向对照）；query 参数只约束主题词不约束措辞，容改写"}, "task": {"user": "Search the web for the latest MLX framework release notes.", "tools": [{"name": "search_web", "description": "Search the web.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}, {"name": "calculator", "description": "Evaluate an arithmetic expression.", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}], "tool_responses": {"search_web": {"results": [{"title": "MLX v0.30 released", "snippet": "Faster quantized inference and new unified-memory APIs."}]}}}, "expect": {"type": "tool_call", "call": {"name": "search_web", "args": {"query": {"regex": "(?i)mlx"}}}, "final": {"must_any": ["0.30", "MLX"]}}}
{"id": "tc-seed-008", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "无工具陷阱（声明天气工具但问物理常识）：测克制率——常识题乱调工具会放大延迟与错误面，是路由「该不该派工具档」的直接证据。光速为时效安全事实"}, "task": {"user": "光在真空中的速度大约是每秒多少公里？", "tools": [{"name": "get_weather", "description": "Query current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}]}, "expect": {"type": "no_call", "final": {"must_any": ["30万", "30 万", "三十万", "299", "300000", "300,000"]}}}
{"id": "tc-seed-009", "dimension": "tool_call", "lang": "en", "source": {"origin": "self", "fit": "英文面无工具陷阱（声明 calculator 但问缩写含义）：与 tc-seed-008 成对，覆盖双语克制率。HTTP 全称为时效安全事实"}, "task": {"user": "What does the acronym HTTP stand for?", "tools": [{"name": "calculator", "description": "Evaluate an arithmetic expression.", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}]}, "expect": {"type": "no_call", "final": {"must_any": ["Hypertext", "HyperText", "hypertext", "超文本"]}}}
{"id": "tc-seed-010", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "多行字符串参数保真——qwen35 XML 相对 JSON 的全部优势点（parser 明言多行保真），gemma4 JSON 需转义；笔记正文是自家 notes 工具真实形态"}, "task": {"user": "记一条笔记，标题是「购物」，正文写两行：第一行 牛奶，第二行 鸡蛋。", "tools": [{"name": "write_note", "description": "Save a note.", "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "body": {"type": "string"}}, "required": ["title", "body"]}}], "tool_responses": {"write_note": {"status": "saved", "id": "note-1"}}}, "expect": {"type": "tool_call", "call": {"name": "write_note", "args": {"title": {"contains": "购物"}, "body": {"contains_all": ["牛奶", "鸡蛋"]}}}, "final": {"must_any": ["记", "笔记", "saved", "保存"]}}}
{"id": "tc-seed-011", "dimension": "tool_call", "lang": "zh", "source": {"origin": "self", "fit": "双必填参数纪律（recipient+content 同时给齐）——发消息是 APNs 推送链路的真实使用面，漏参会被 MCP 参数校验打回"}, "task": {"user": "给妈妈发条消息，说我今晚加班晚点回家。", "tools": [{"name": "send_message", "description": "Send a message to a contact.", "parameters": {"type": "object", "properties": {"recipient": {"type": "string"}, "content": {"type": "string"}}, "required": ["recipient", "content"]}}], "tool_responses": {"send_message": {"status": "sent"}}}, "expect": {"type": "tool_call", "call": {"name": "send_message", "args": {"recipient": {"contains": "妈"}, "content": {"contains": "晚"}}}, "final": {"must_any": ["发", "sent", "已发送"]}}}
{"id": "tc-seed-012", "dimension": "tool_call", "lang": "en", "source": {"origin": "self", "fit": "口语实体到参数值的规范化（Apple→AAPL 或原词均容）：查询类 API 工具对入参规范化的宽容度画像，容两形不判死"}, "task": {"user": "How is Apple's stock doing today?", "tools": [{"name": "get_stock_price", "description": "Get the latest stock quote for a ticker symbol or company name.", "parameters": {"type": "object", "properties": {"symbol": {"type": "string"}}, "required": ["symbol"]}}], "tool_responses": {"get_stock_price": {"symbol": "AAPL", "price": 231.6, "change_pct": 1.2}}}, "expect": {"type": "tool_call", "call": {"name": "get_stock_price", "args": {"symbol": {"regex": "(?i)aapl|apple"}}}, "final": {"must_any": ["231"]}}}
