<!DOCTYPE html>
<html lang="ja">

<head>
  <meta http-equiv="content-type" content="text/html; charset=UTF-8">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
    crossorigin="anonymous">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <script>
    function addRow(){
      const buyForm = document.getElementById('buyForm');
      const inputRow = document.createElement('div');
      inputRow.className = `form-group`;
      inputRow.innerHTML = `
        <label for="item">商品ID: </label>
        <input type="number" name="item" class="form-control">
        <label for="num">購入個数: </label>
        <input type="number" name="num" class="form-control">
      `;
      buyForm.prepend(inputRow);
    };
  </script>
</head>

<body class="container">
  <header>
    <h1 class="display-4">
      <%= title %>
    </h1>
  </header>
  <div role="main">
    <table class="table">
      <%- items %>
    </table>
  </div>
  <div role="main">
    <p class="h6"><%= content %></p>
    <form method="post" action="/hello/post" id="buyForm">
      <div class="form-group">
        <label for="item">商品ID: </label>
        <input type="number" name="item" class="form-control">
        <label for="num">購入個数: </label>
        <input type="number" name="num" class="form-control">
      </div>
      <button type="button" onclick="addRow">add</button>
      <input type="submit" value="送信" class="btn btn-primary">
    </form>
  </div>
</body>

</html>