# ═══════════ 系统 / 编辑器 ═══════════
.DS_Store
.vscode/
.idea/
*.swp

# ═══════════ 密钥 / 环境变量（模板 .env.example 除外）═══════════
.env
.env.*
!.env.example

# ═══════════ Python ═══════════
__pycache__/
*.pyc
.venv/

# ═══════════ Node / 前端构建产物 ═══════════
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ═══════════ 模型权重（首启自动下载，动辄数 GB）═══════════
backend/models/
rag/models/
# 启动模型选择指针（./devctl.sh model 写入，机器本地状态，真相在 config.yaml 注册表）
.model-selection
.rag-tier-selection

# ═══════════ 运行时数据（用户会话 / 知识库 / 任务实体）═══════════
backend/sessions/
# 漂移巡检状态（framework/maintenance/drift_patrol.py 运行期写入）
backend/maintenance/
# FTS 关键词索引（rag/fts_index.py 运行期建，随向量库重建可再生）
rag/fts_index.sqlite3*
# 长期记忆笔记（R4）：agent 写下的用户个人事实。绝不入库——本仓库托管在 GitHub。
backend/notes/
inference/media/
inference/kvstore/
backend/schedules/
backend/push/
# 云端顾问出网台账（铁律 6 出网日志，data_dir()/cloud/——含 payload 长度与费用，运行期数据）
backend/cloud/
# 待确认注册队列（D.18 对话式注册，data_dir()/registrations/——模型草稿，确认前不生效）
backend/registrations/
backend/ui_state.json
backend/guardrail_events.jsonl
# UI 添加的私人 API 声明 + 密钥文件（dev 模式 data_dir=backend/；仓库根 api_tools/ 是手写声明，照常入库）
backend/api_tools/
# UI 添加的用户剧本（dev 模式 data_dir=backend/；仓库根 skills/ 是内置剧本，照常入库）
backend/skills/
rag/chroma_data/
rag/storage/

# ═══════════ 日志 / 进程文件 ═══════════
logs/
*.log
*.pid
# 例外：benchmarks/data/ 与 backend/benchmarks/ 下的 .log 是**测量原始件**，
# 不是运行日志——文档/台账直接引用它们作证据，被上面的 *.log 静默吞掉会让
# 结论不可复算（08-16 复审：T5 整站与 T6b 头号结论的唯一原始证据都曾因此漏
# 入库）。入库前照例密扫。backend 树里存在名为 logs/ 的结果子目录，须先解除
# 目录级排除才能豁免其中文件（git 不能从被排除目录里再包含文件）。
# 注意：backend/benchmarks/model_eval/results/ 有本地 .gitignore 的 `*`（E7
# 拍板：运行产物含大段生成文本不入库，结论走评测报告）——嵌套规则更深者优先，
# 该目录不受下面豁免影响，属有意设计而非疏漏。
!benchmarks/data/**/*.log
!backend/benchmarks/**/logs/
!backend/benchmarks/**/*.log
# benchmarks/baseline/ 下的战役日志是测量证据链，整树豁免（08-16 stage review M8：
# 钉死单日期目录会让下一场 campaign 的日志再次被 *.log 静默吞掉）
!benchmarks/baseline/**/*.log

# ═══════════ SearXNG（settings.yml 含随机 secret_key，由 devctl 首启生成；源码由 setup 克隆）═══════════
searxng/settings.yml
searxng/searxng-src/

# ═══════════ 构建产物（R5-3）═══════════
# scripts/build-runtime.sh 在这里造 949M 的内嵌 Python 运行时（PBS + edge 依赖）
# 与 .pbs-cache 的上游压缩包。全是可从 requirements-edge.txt 重造的派生物。
/build/

# ═══════════ Apple 原生客户端（源码入库，D.6；派生物与签名资产不入）═══════════
# R5 要把执行层收编进 macOS app，app 源码从此是本仓库的一等公民——
# 「记录遗失也能续工」的前提是它在库里（D.6）。只忽略派生物与本机签名资产。
apple-app/build/
apple-app/Generated/
apple-app/MacAgentClient.xcodeproj/
apple-app/.DS_Store
# 签名资产：私钥/证书/描述文件绝不入库（apple-app/.gitignore 另有一份更细的同类规则）
apple-app/**/*.p12
apple-app/**/*.p8
apple-app/**/*.mobileprovision

