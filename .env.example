# 环境变量模板（整个项目共用一份，放仓库根）。
# 复制为 .env.local 后填写真实值；.env / .env.local 已被 .gitignore 忽略，绝不入库。
#
# 读取方：
#   - devctl.sh 启动时 source（.env 先、.env.local 后覆盖），export 给 backend 进程
#   - 前端 Vite 的 envDir 也指向仓库根（见 frontend/vite.config.ts），读的是同一份文件

# ── 后端鉴权密钥 ────────────────────────────────────────────────────
# backend 读 AGENT_API_KEY 强制 Bearer 校验（留空 = 未启用，启动告警后放行）；
# Vite 代理在 Node 侧把它注入 Authorization 头，浏览器 bundle 永不持有 key
# （无 VITE_ 前缀的变量不会被打进客户端）。
AGENT_API_KEY=

# ── 推理服务鉴权密钥（HETERO_COMPUTE B1，仅 inference.mode=remote 时相关）──
# inference-server（inference/server.py，设备 A）读 INFER_API_KEY 强制 Bearer 校验；
# backend 的 RemoteBackend（设备 B）读同一变量携带。两侧 .env.local 填同一个值。
# 留空 = 未启用（启动告警后放行，仅限开发/回环）。跨机部署必须设置（§8 部署铁则：
# 非回环绑定只允许出现在受信内网）。
INFER_API_KEY="test"

# ── RAG 服务鉴权密钥（HETERO_COMPUTE B2a）──────────────────────────────
# rag 服务（rag/rag_server.py，设备 A）读 RAG_API_KEY 强制 Bearer 校验；backend 的三个
# rag 客户端（rag_search / rag_admin / rag_sink，设备 B）读同一变量携带。两侧 .env.local
# 填同一个值。留空 = 未启用（启动告警后放行，仅限开发/回环）。跨机部署必须设置——
# rag 绑定非回环地址却没设本变量会被护栏**拒绝启动**（§8 部署铁则同上）。
RAG_API_KEY=

# ── RAG 计算面鉴权密钥（HETERO_COMPUTE B2c，仅 rag.compute.host 非空时相关）──
# 数据/计算拆分：compute_server（rag/compute_server.py，算力端 :14162）读
# RAG_COMPUTE_API_KEY 强制 Bearer 校验；工作端的数据面（rag_server.py）读同一变量携带。
# 两侧 .env.local 填同一个值。留空 = 未启用（仅限开发/回环）；compute 绑定非回环地址
# 却没设本变量会被护栏**拒绝启动**（§8 部署铁则同上）。
RAG_COMPUTE_API_KEY=

# ── App Store Connect API（apple-app/ 的 iOS 发布管线，R5-1）──────────
# 只有发布 TestFlight 才需要；日常开发与联调用不到，留空即可。
# 真正的密钥是私钥 .p8，它**在仓库外**（~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8），
# 任何时候都不要移进仓库。这里两项只是标识符（ASC 后台可见），单独无法鉴权——
# 参数化是为了万一仓库转公开时不必回头洗 git 历史。
# 读取方：apple-app/{asc-update-signing.py, wait-testflight.py, release-ios.sh}
ASC_KEY_ID=
ASC_ISSUER_ID=

# ── 前端直连后端（一般不用）───────────────────────────────────────
# 默认留空 = 同源相对路径，由 Vite 的 /api 代理转发到本机 backend（127.0.0.1:14159）。
# 仅当需要让浏览器绕过代理直连某个远程 backend 时才设置（此时鉴权头需自行解决）：
# VITE_AGENT_API_BASE=http://<host>:14159
VITE_AGENT_API_BASE=
